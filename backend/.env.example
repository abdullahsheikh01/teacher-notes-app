LLM_API_KEY=sk-your-key-here
LLM_MODEL=gpt-4o-mini

# Optional: any OpenAI-compatible endpoint. Leave empty to use OpenAI directly.
# When set, LLM_API_KEY / LLM_MODEL are that provider's key and model name.
# Examples:
#   Gemini:     https://generativelanguage.googleapis.com/v1beta/openai/   (model: gemini-2.5-flash)
#   Groq:       https://api.groq.com/openai/v1                             (model: llama-3.3-70b-versatile)
#   OpenRouter: https://openrouter.ai/api/v1                               (model: openai/gpt-4o-mini)
#   Ollama:     http://localhost:11434/v1                                  (model: llama3.1, any key)
LLM_BASE_URL=
